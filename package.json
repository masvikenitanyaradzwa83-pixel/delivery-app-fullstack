    "build": "cd client && npm run build"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "stripe": "^17.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
